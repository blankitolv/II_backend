{{#if error}}
  <div class="alert alert-danger" role="alert">
    Error al crear el producto. Por favor, verifique los datos.
  </div>
{{/if}}
<div class="container mt-4" id="cart-container" data-cart-id="{{user.cart}}">
  <div class="container">
  {{> dump_partial id="debug-products" context=products}}
  </div>
  <h1>Products</h1>
  <div class="row">
    {{#each products.docs}}
      <div class="col-md-4 mb-4">
        <div class="card">
          <img
            src="{{#if this.thumbnails.[0]}}{{this.thumbnails.[0]}}{{else}}./assets/img/ph.jpg{{/if}}"
            class="card-img-top"
            style="height: 200px; object-fit: cover; width: 100%;"
            alt="{{this.title}}"
          />
          <div class="card-body">
            <h5 class="card-title text-center">{{this.title}}</h5>
              <p class="card-text p-1 m-2" 
              style="height: 100px; overflow: hidden;" >{{this.description}}</p>
              <p class="card-text"><strong>Price:</strong> ${{this.price}}</p>
              <p class="card-text"><strong>Stock:</strong> {{this.stock}}</p>
            <button
              {{if_stock this.stock}}
              class="btn btn-primary add-to-cart"
              data-product-id="{{this._id}}"
            >Add to Cart</button>
          </div>
        </div>
      </div>
    {{/each}}
  </div>
</div>
<script src="/cart.js"></script>
