<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="container border rounded p-4 my-3">
      <h3 class="text-center mb-4">Forgot Password</h3>
      <p class="text-center text-muted">Enter your email address and we will send you a link to reset your password.</p>
      <form method="POST" action="/api/sessions/forgot-password">
        <div class="mb-3">
          <label for="inputEmail" class="form-label">Email</label>
          <input
            type="email"
            class="form-control"
            id="inputEmail"
            name="email"
            required
          />
        </div>
        <button type="submit" class="btn btn-primary w-100 mt-3">Send Recovery Link</button>
      </form>
      <div class="text-center mt-3">
        <a href="/login">Back to Login</a>
      </div>
    </div>
  </div>
</div>
